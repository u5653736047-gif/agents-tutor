# DeepSeek OpenAI-compatible API
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-api-key

# Agent 默认工作区（可选；本地启动脚本默认绑定仓库根目录）
# API_WORKSPACE_ROOT=
# 可选的工作区选择边界；多个根目录用系统 PATH 分隔符分隔
# （Windows 为 ;，Linux/macOS 为 :）。未设置时，本地模式允许用户
# 明确选择任意现有目录；部署环境建议始终设置。
# API_WORKSPACE_ALLOWED_ROOTS=

# 知识库（工作单 T2，可选；全部注释掉时 API 使用代码内置默认：仓库根 data/）
# 词法库路径；默认 data/knowledge.db（仓库根）
# API_KNOWLEDGE_DB_PATH=
# 向量库路径；默认 data/vector_knowledge.db（仓库根）；不可用时自动降级纯词法
# API_VECTOR_DB_PATH=
# 向量 embedding 模式：auto=优先 fastembed、缺失回退哈希（默认）；hash=强制哈希
# API_KNOWLEDGE_EMBEDDING=
# LLM 查询改写：auto=已配置 DEEPSEEK_API_KEY 时启用（默认，多变体联合检索提升
# 召回）；off=强制关闭；未配置 key 时 auto 自动跳过
# API_KNOWLEDGE_REWRITE=
# Cross-Encoder 重排：auto=fastembed 可用时启用（默认，初检候选精排，构造失败
# 自动降级不重排）；off=强制关闭。首次启用需联网下载模型约 280MB，之后离线
# API_KNOWLEDGE_RERANK=
# 重排模型名；默认 BAAI/bge-reranker-base
# API_RERANK_MODEL=

# PDF 表格结构化提取：auto=已安装 pdf-table 依赖组时启用（默认，表格转
# GFM Markdown 附在页文本后，附件链路与入库链路共用）；off=强制关闭。
# 未装依赖时 auto 自动回退 pypdf 纯文本，行为与现状一致
# API_PDF_TABLE_MODE=
# 图片理解视觉端点（S5-B3）：三级降级链第一级（VLM → OCR → 友好提示）。
# DeepSeek 主站不支持图片输入；面向自选 OpenAI 兼容视觉端点（如 Qwen-VL）。
# 三项均配置才启用；调用预算 timeout=10s / max_retries=0 / max_tokens=512
# API_VISION_MODE=
# API_VISION_BASE_URL=
# API_VISION_MODEL=
# API_VISION_API_KEY=

# Office 文档工具（officecli 集成，默认禁用）
# 显式设为 1 才注册 officecli_inspect / officecli_edit 两个工具；开启时启动会
# 解析二进制并自检（--version），找不到或不可执行则启动失败（fail-fast）。
# 未开启（0 / false / 未设置）时完全不注册、不做任何二进制探测，无 officecli
# 的环境（CI / 评委机）可正常启动。
# API_OFFICECLI_ENABLED=0
# officecli 二进制名或绝对路径；默认从 PATH 查找 "officecli"
# API_OFFICECLI_BINARY=officecli
# 只读工具子进程超时（秒）；执行器时限由后端按 +5 秒自动推导
# API_OFFICECLI_TIMEOUT_READ_SECONDS=60
# 写工具子进程超时（秒）
# API_OFFICECLI_TIMEOUT_WRITE_SECONDS=120
# 单次 stdout+stderr 合并上限（字节）
# API_OFFICECLI_MAX_OUTPUT_BYTES=131072
